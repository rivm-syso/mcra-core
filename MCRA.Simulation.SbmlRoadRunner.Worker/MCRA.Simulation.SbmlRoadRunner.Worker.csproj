<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\Shared\MCRA.Shared.Build.targets" />
  <PropertyGroup>
    <UserSecretsId>6ad0e0b4-af2b-4e24-b267-1ac4797dbb49</UserSecretsId>
    <Configurations>Debug;Release</Configurations>
    <AccelerateBuildsInVisualStudio>false</AccelerateBuildsInVisualStudio>
  </PropertyGroup>
  <PropertyGroup>
    <ModuleExtension Condition="'$(OS)' == 'Windows_NT'">.dll</ModuleExtension>
    <ModuleExtension Condition="'$(OS)' != 'Windows_NT'">.so</ModuleExtension>
  </PropertyGroup>
  <PropertyGroup>
    <ReferencedConfiguration>$(Configuration)</ReferencedConfiguration>
    <ReferencedCOnfiguration Condition="'$(Configuration)' != 'Debug'">Release</ReferencedCOnfiguration>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="pythonnet" Version="3.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MCRA.General\MCRA.General.csproj" />
  </ItemGroup>

  <Target Name="CopyWorkerOutput" AfterTargets="Build">
    <ItemGroup>
      <WorkerOutputFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerOutputFiles)"
          DestinationFiles="@(WorkerOutputFiles->'$(MSBuildProjectDirectory)\..\MCRA.Simulation.Commander\bin\$(Configuration)\SbmlRoadrunnerWorker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WorkerOutputFiles)"
          DestinationFiles="@(WorkerOutputFiles->'$(MSBuildProjectDirectory)\..\bin\SbmlRoadrunnerWorker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CleanWorkerOutput" BeforeTargets="Clean">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\..\MCRA.Simulation.Commander\bin\$(Configuration)\SbmlRoadrunnerWorker;$(MSBuildProjectDirectory)\..\bin\SbmlRoadrunnerWorker" />
  </Target>
</Project>

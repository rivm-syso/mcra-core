      <Id>idExposureSet</Id>
      <Description>Exposure set identification code.</Description>
      <Aliases>
        <string>idExposureSet</string>
        <string>ExposureSet</string>
      </Aliases>
      <ForeignKeyTables>
        <string>ConsumerProductExposureSets</string>
      </ForeignKeyTables>
    </ColumnDefinition>
    <ColumnDefinition  Required="true" FieldType="Numeric">
      <Id>Percentage</Id>
      <Description>Percentage value of the exposure percentile.</Description>
      <Aliases>
        <string>Percentage</string>
      </Aliases>
    </ColumnDefinition>
    <ColumnDefinition Required="true" FieldType="Numeric">
      <Id>Value</Id>
      <Description>Value of the exposure percentile.</Description>
      <Aliases>
        <string>Value</string>
      </Aliases>
    </ColumnDefinition>
  </ColumnDefinitions>
</TableDefinition>

<?xml version="1.0" encoding="utf-8"?>
<TableDefinition>
  <Id>ConsumerProductExposurePercentiles</Id>
  <Name>Consumer product exposure percentiles</Name>
  <Description>
    Describes the exposure percentiles in the study.
  </Description>
  <Aliases>
    <string>ConsumerProductExposurePercentiles</string> 
    <string>CPExposurePercentiles</string>
  </Aliases>
  <PreferredAlias>CPExposurePercentiles</PreferredAlias>
  <HiddenAliases>
    <string>RawConsumerProductExposurePercentiles</string>
  </HiddenAliases>
  <TargetDataTable>RawConsumerProductExposurePercentiles</TargetDataTable>
  <ColumnDefinitions>

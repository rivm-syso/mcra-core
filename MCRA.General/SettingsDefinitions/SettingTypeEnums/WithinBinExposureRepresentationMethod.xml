<?xml version="1.0" encoding="utf-8"?>
<UnitDefinition>
  <Id>WithinBinExposureRepresentationMethod</Id>
  <Name>Within bin exposure representation method</Name>
  <Description>
    Method used for selecting the value within a bin that should represent the exposure for the bin.
  </Description>
  <IsInternalEnum>true</IsInternalEnum>
  <Units>
    <Unit>
      <Id>BinLowerLimit</Id>
      <Name>Bin lower limit</Name>
      <ShortName>Bin lower limit</ShortName>
      <Description>
        Lower limit of the bin.
      </Description>
    </Unit>
    <Unit>
      <Id>BinUpperLimit</Id>
      <Name>Bin upper limit</Name>
      <ShortName>Bin upper limit</ShortName>
      <Description>
        Upper limit of the bin.
      </Description>
    </Unit>
    <Unit>
      <Id>BinMidpoint</Id>
      <Name>Bin midpoint</Name>
      <ShortName>Bin midpoint</ShortName>
      <Description>
        Midpoint of the bin.
      </Description>
    </Unit>
  </Units>
</UnitDefinition>
